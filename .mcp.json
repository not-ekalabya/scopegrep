{
  "mcpServers": {
    "scopegrep": {
    "command": "uv",
    "args": [
      "run", "--quiet", "--no-project", "--python", "3.12",
      "--with", "mcp>=1.2.0",
      "--with", "httpx>=0.27",
      "python", "${CLAUDE_PLUGIN_ROOT}/src/scopegrep/server.py"
    ],
    "env_vars": [
      "SCOPEGREP_URL",
      "SCOPEGREP_TOKEN",
      "SCOPEGREP_ROOT"
    ]
    }
  }
}
